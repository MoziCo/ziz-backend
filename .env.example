# Ziz API Configuration Example
# Copy this file to .env and update the values

# API Configuration
API_TITLE="Ziz Evaluation API"
API_DESCRIPTION="User-experience-driven evaluation framework for AI applications"
API_VERSION="0.1.0"
DEBUG=false

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Database Configuration
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="ziz_db"

# Authentication
SECRET_KEY="your-secret-key-change-in-production"
API_KEY_HEADER="X-API-Key"

# CORS Configuration
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL="INFO"

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000

# Batch Processing
MAX_BATCH_SIZE=1000
ENABLE_BATCH_ENDPOINTS=true
